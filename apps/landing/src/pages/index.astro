---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Primitives from '../components/Primitives.astro';
import Install from '../components/Install.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gandalf — See what your agents changed"
  description="Gandalf lets developers inspect local AI agent setup, browse agent-native marketplace/source entries, and apply only reviewed provider-backed changes."
>
  <main>
    <Hero />
    <Manifesto />
    <Primitives />
    <Install />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
