---
import { Check } from 'lucide-react';

const surfaces = ["[mcp_servers]", "[[skills]]", "[hooks]", "[env_template]"];

const manifestSnippet = [
  '# gandalf.toml (team manifest)',
  'version = "1.0"',
  'agents = ["claude-code", "codex"]',
  '',
  '[mcp_servers.postgres-db]',
  'command = "npx"',
  'args = ["-y", "@mcp/postgres", "${DB_URL}"]',
  'required_env = ["DB_URL"]',
  '',
  '[[skills]]',
  'name = "team-reviewer"',
  'source = "./.gandalf/skills/team-reviewer"',
];

const driftOutput = [
  '$ gandalf check',
  '🔍 Target: claude-code (~/.claude/settings.json)',
  '  ❌ missing mcp: postgres-db',
  '  ❌ missing skill: team-reviewer',
  '',
  '⚡ 2 team items out of sync.',
  '   Run "gandalf apply" to sync safely.',
];

const signals = [
  ["Manifest", "gandalf.toml"],
  ["Smart Merge", "non-destructive"],
  ["Safety Net", "pre-apply snapshot"],
];
---

<section class="section manifesto" id="why">
  <div class="container manifesto__grid">
    <div class="manifesto__copy">
      <p class="section-meta">
        <span class="section-meta__num">01</span> &nbsp;/&nbsp; The Problem
      </p>

      <h2 class="section-title manifesto__title">
        "It works on my agent" is the new "it works on my machine."
      </h2>

      <p class="section-lede manifesto__lede">
        Previously, teams onboarded developers by installing an IDE and extensions. Today, engineers build with AI agents — but every agent has different MCP servers, missing skills, and unverified hooks.
      </p>

      <div class="manifesto__signals" aria-label="Gandalf safety signals">
        {signals.map(([label, value]) => (
          <div>
            <Check size={14} strokeWidth={2} aria-hidden="true" />
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>

    <div class="proof-board" aria-label="Agent Environment as Code proof">
      <div class="proof-board__files">
        <div class="proof-board__head">manifest schema</div>
        {surfaces.map((surf, index) => (
          <code class:list={[index === 0 ? "is-active" : ""]}>{surf}</code>
        ))}
      </div>

      <div class="proof-board__diff">
        <div class="proof-board__head">declarative manifest vs drift check</div>
        <div class="diff-grid">
          <div>
            <span>gandalf.toml</span>
            {manifestSnippet.map((line) => <code>{line || "\u00a0"}</code>)}
          </div>
          <div>
            <span>local agent status</span>
            {driftOutput.map((line, index) => (
              <code class:list={[index === 2 || index === 3 ? "is-danger" : "", index === 5 ? "is-change" : ""]}>{line || "\u00a0"}</code>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto {
    background: rgb(255 255 255 / 0.84);
  }

  .manifesto__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: 54px;
    align-items: center;
  }

  .manifesto__title {
    max-width: 14ch;
    font-size: clamp(2.0rem, 2.8vw, 2.8rem);
    line-height: 1.15;
  }

  .manifesto__lede {
    max-width: 38ch;
    font-size: 0.96rem;
    line-height: 1.6;
    margin-top: 14px;
    color: var(--muted-foreground);
  }

  .manifesto__signals {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    max-width: 360px;
  }

  .manifesto__signals div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font-size: 0.84rem;
  }

  .manifesto__signals svg {
    color: var(--brand);
    flex: 0 0 auto;
  }

  .manifesto__signals span {
    color: var(--muted-foreground);
    margin-right: auto;
  }

  .manifesto__signals strong {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--foreground);
    font-size: 0.8em;
  }

  .proof-board {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: 0 16px 40px -32px rgb(15 23 42 / 0.35);
    overflow: hidden;
  }

  .proof-board__head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: #fafafa;
  }

  .proof-board__files {
    border-right: 1px solid var(--border);
    background: #fafafa;
    display: flex;
    flex-direction: column;
  }

  .proof-board__files code {
    display: block;
    padding: 8px 14px;
    font-size: 0.78rem;
    color: var(--muted-foreground);
    border-bottom: 1px solid rgb(0 0 0 / 0.04);
  }

  .proof-board__files code.is-active {
    color: var(--brand);
    font-weight: 600;
    background: #ffffff;
  }

  .proof-board__diff {
    min-width: 0;
  }

  .diff-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .diff-grid > div {
    padding: 12px 14px;
    overflow-x: auto;
  }

  .diff-grid > div:first-child {
    border-right: 1px solid var(--border);
    background: #ffffff;
  }

  .diff-grid > div:last-child {
    background: #09090b;
    color: #a1a1aa;
  }

  .diff-grid > div:last-child span {
    color: #71717a;
  }

  .diff-grid span {
    display: block;
    color: var(--muted-foreground);
    margin-bottom: 8px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .diff-grid code {
    display: block;
    white-space: pre;
  }

  .diff-grid code.is-danger {
    color: #f87171;
  }

  .diff-grid code.is-change {
    color: var(--brand);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .manifesto__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .proof-board {
      grid-template-columns: 1fr;
    }

    .proof-board__files {
      border-right: none;
      border-bottom: 1px solid var(--border);
      flex-direction: row;
      flex-wrap: wrap;
    }

    .diff-grid {
      grid-template-columns: 1fr;
    }

    .diff-grid > div:first-child {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
