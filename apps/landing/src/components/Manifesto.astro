---
import { Check } from 'lucide-react';
import ManifestoTerminal from './ui/ManifestoTerminal';

const signals = [
  ["Manifest", "gandalf.toml"],
  ["Smart Merge", "non-destructive"],
  ["Safety Net", "pre-apply snapshot"],
];
---

<section class="section manifesto" id="why">
  <div class="container manifesto__grid">
    <div class="manifesto__copy">
      <p class="section-meta">
        <span class="section-meta__num">01</span> &nbsp;/&nbsp; The Problem
      </p>

      <h2 class="section-title manifesto__title">
        "It works on my agent" is the new "it works on my machine."
      </h2>

      <p class="section-lede manifesto__lede">
        Previously, teams onboarded developers by installing an IDE and extensions. Today, engineers build with AI agents — but every agent has different MCP servers, missing skills, and unverified hooks.
      </p>

      <div class="manifesto__signals" aria-label="Gandalf safety signals">
        {signals.map(([label, value]) => (
          <div>
            <Check size={14} strokeWidth={2} aria-hidden="true" />
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>

    <div class="manifesto__terminal" aria-label="Agent Environment as Code proof">
      <ManifestoTerminal client:only="react" />
    </div>
  </div>
</section>

<style>
  .manifesto {
    background: rgb(255 255 255 / 0.84);
  }

  .manifesto__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: 54px;
    align-items: center;
  }

  .manifesto__title {
    max-width: 14ch;
    font-size: clamp(2.0rem, 2.8vw, 2.8rem);
    line-height: 1.15;
  }

  .manifesto__lede {
    max-width: 38ch;
    font-size: 0.96rem;
    line-height: 1.6;
    margin-top: 14px;
    color: var(--muted-foreground);
  }

  .manifesto__signals {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    max-width: 360px;
  }

  .manifesto__signals div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font-size: 0.84rem;
  }

  .manifesto__signals svg {
    color: var(--brand);
    flex: 0 0 auto;
  }

  .manifesto__signals span {
    color: var(--muted-foreground);
    margin-right: auto;
  }

  .manifesto__signals strong {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--foreground);
    font-size: 0.8em;
  }

  .manifesto__terminal {
    min-width: 0;
    width: 100%;
  }

  @media (max-width: 900px) {
    .manifesto__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
