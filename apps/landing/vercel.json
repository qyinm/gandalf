{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://docs.usegandalf.com",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.usegandalf.com",
      "permanent": true
    }
  ]
}
