{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".vercel/output/**",
        ".astro/**",
        "bin/**"
      ],
      "inputs": [
        "src/**",
        "public/**",
        "**/*.go",
        "go.mod",
        "go.sum",
        "astro.config.mjs",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": [],
      "inputs": [
        "**/*.go",
        "**/*.ts",
        "**/*.tsx",
        "tests/**"
      ]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
